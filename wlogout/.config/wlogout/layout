{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "hyprshutdown",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Shutting Down...' --post-cmd 'shutdown -P 0'",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Rebooting System...' --post-cmd 'reboot'",
    "keybind" : "r"
}
